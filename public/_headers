# Cloudflare Pages 响应头
# 短期直接使用 pages.dev 做 SEO 观察，因此不再对 pages.dev 加 noindex。
# 以后绑定自定义域名时，若要避免 pages.dev 重复收录，可恢复 host 级 noindex。

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/font/*
  Cache-Control: public, max-age=31536000, immutable

/chunks/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache
