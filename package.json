{
  "name": "tab-forge",
  "version": "1.0.0",
  "description": "扒谱工具 - Guitar Tablature Transcriber (吉他六线谱转录器)",
  "main": "src/popup.ts",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc && node scripts/lint-layers.mjs && vite build",
    "dev:web": "vite dev --config vite.web.config.ts",
    "build:web": "tsc && node scripts/lint-layers.mjs && vite build --config vite.web.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:layers": "node scripts/lint-layers.mjs"
  },
  "keywords": [
    "guitar",
    "tab",
    "tablature",
    "music",
    "transcriber"
  ],
  "author": "Sean Xie",
  "license": "ISC",
  "devDependencies": {
    "@types/chrome": "^0.2.6",
    "typescript": "~5.8.3",
    "vite": "^4.3.9",
    "vite-plugin-static-copy": "^0.17.1",
    "vitest": "^0.34.6"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4"
  }
}
